# Server Port
PORT=6000

# Node Environment (development / production)
NODE_ENV=development

# MongoDB Connection String (Paste your MongoDB Atlas Connection URI here)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/interviewai?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_12345

# OpenRouter AI API Key (for interview questions and answer evaluations)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# OpenRouter Model (defaults to openai/gpt-4o-mini; for free tier use e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Razorpay Credentials (Optional for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend Application URL (for CORS and Socket.io)
FRONTEND_URL=http://localhost:5173
